# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Argentina/Buenos_Aires

# Database
# Leave unset to use a local SQLite file (backend/db.sqlite3), which is fine
# for local development. Set DATABASE_URL to point at PostgreSQL anywhere
# else, e.g.:
# DATABASE_URL=postgres://mercado_user:mercado_pass@localhost:5432/mercado_de_pases
DATABASE_URL=

# Auth
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# CORS / CSRF - comma separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie security (leave as-is locally; set True behind HTTPS in production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
